# Backend API Base URL (Live hone par apna API domain dalein, eg: https://api.digicoders.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Client Public Quotation View Domain (Optional)
# Agar aap chahte hain ki WhatsApp par direct live domain jaye to yaha set karein:
# Example: VITE_PUBLIC_URL=https://crm.digicoders.com
# Khali chhodenge to jo browser me open hoga wahi domain automatically use hoga.
# VITE_PUBLIC_URL=https://crm.digicoders.com
